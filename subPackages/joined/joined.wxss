/* subPackages/joined/joined.wxss */
page {
  background-color: #f5f7fa;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 16rpx 8rpx 32rpx;   /* 【优化】左右 12→8 更撑满；上 24→16；底 60→32 */
  min-height: 100vh;
  box-sizing: border-box;
  /* 【关键】覆盖 app.wxss 全局 .container 的 align-items: center，否则卡片会被居中显示 */
  display: block;
  align-items: stretch;
  justify-content: flex-start;
}

/* ========== 加载状态 ========== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  gap: 20rpx;
  color: #999;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e5e7eb;
  border-top-color: #007aff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========== 未登录 ========== */
.login-tip {
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}
.login-icon {
  font-size: 80rpx;
}
.login-text {
  color: #999;
  font-size: 30rpx;
}
.btn-go-login {
  background-color: #007aff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 16rpx 60rpx;
  border: none;
  line-height: 1.4;
}
.btn-go-login::after { border: none; }

/* ========== 分组标题 ========== */
.section {
  margin-bottom: 16rpx;          /* 【优化】36→16，组间紧凑 */
}
.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 4rpx;               /* 【优化】8→4 与 container 对齐 */
  margin-bottom: 14rpx;          /* 【优化】20→14 */
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  position: relative;
  padding-left: 18rpx;
}
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  background: #007aff;
  border-radius: 4rpx;
}
.section-count {
  font-size: 24rpx;
  color: #999;
  background: #eef0f4;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  line-height: 1.2;
}
.section-count.warn {
  color: #fff;
  background: #ef4d4d;
}

/* ========== 卡片通用 ========== */
.msg-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 24rpx 18rpx;    /* 【优化】28→24，卡片内部更撑满 */
  margin-bottom: 14rpx;          /* 【优化】20→14，卡片间紧凑 */
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: box-shadow 0.2s;
}
.msg-card:active {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.msg-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.msg-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  line-height: 1.4;
  font-weight: 500;
}
.msg-from {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.msg-time {
  font-size: 22rpx;
  color: #bbb;
  flex-shrink: 0;
}

.msg-body {
  padding: 8rpx 0 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
  margin-bottom: 16rpx;
}
.info-line {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  line-height: 1.6;
  padding: 4rpx 0;
}
.info-key {
  color: #999;
  width: 160rpx;
  flex-shrink: 0;
}
.info-val {
  color: #333;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.msg-actions button {
  font-size: 26rpx;
  border-radius: 30rpx;
  border: none;
  padding: 0;
  margin: 0;
  height: 60rpx;
  line-height: 60rpx;
  width: 160rpx;
  font-weight: 500;
}
.msg-actions button::after { border: none; }

.btn-reject {
  background: #f3f4f6;
  color: #666;
}
.btn-accept {
  background: #409EFF;
  color: #fff;
}
.btn-hover {
  opacity: 0.7;
}

.msg-status {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  padding-top: 8rpx;
}
.status-pending {
  display: inline-block;
  background: #fff7e6;
  color: #d97706;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 链接按钮（系统通知用） */
.btn-link {
  background: transparent;
  color: #666;
  font-size: 26rpx;
  width: 140rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 30rpx;
}
.btn-link.primary {
  color: #007aff;
  font-weight: 500;
}
.btn-link::after { border: none; }

/* ========== 标签色 ========== */
.tag-notify {
  background: #fef0f0;
  color: #e54545;
}
.tag-apply {
  background: #ecf3ff;
  color: #3b82f6;
}
.tag-invite {
  background: #f3eeff;
  color: #8b5cf6;
}
.tag-sent {
  background: #fef7e6;
  color: #d97706;
}

/* ========== 卡片左侧装饰条 ========== */
.notify-card { border-left: 8rpx solid #e54545; }
.apply-received-card { border-left: 8rpx solid #3b82f6; }
.invite-card { border-left: 8rpx solid #8b5cf6; }
.apply-card { border-left: 8rpx solid #d97706; }
.invite-sent-card { border-left: 8rpx solid #d97706; }

/* ========== 空态 ========== */
.empty {
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-icon {
  font-size: 100rpx;
}
.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}
.empty-desc {
  font-size: 26rpx;
  color: #bbb;
}