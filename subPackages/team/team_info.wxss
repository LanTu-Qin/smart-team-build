page {
  background-color: #f5f7fa;
  font-size: 30rpx;
  color: #333;
}
.page-wrap {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

/* 主卡片 */
.team-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx;                /* 【优化】32→36 更舒展 */
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.info-row {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;         /* 【优化】行间留白 */
  border-bottom: 1rpx solid #f5f5f5;  /* 【优化】行间分隔线 */
}
.info-row:last-of-type {
  border-bottom: none;
  padding-bottom: 0;
}
/* 队伍名称行突出 */
.info-row:first-of-type .val {
  font-size: 38rpx;              /* 【优化】队伍名加大 */
  font-weight: 600;
  color: #111;
  letter-spacing: 1rpx;
}
.label {
  display: block;
  font-size: 26rpx;              /* 【优化】28→26 弱化标签 */
  color: #999;
  margin-bottom: 14rpx;
}
.val-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.val {
  font-size: 30rpx;
  color: #333;
}
.copy-text {
  font-size: 26rpx;
  color: #007aff;
  flex-shrink: 0;
}

/* 赛事项 */
.comp-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}
.comp-name {
  font-size: 30rpx;
  color: #222;
  flex: 1;
}

/* 招募需求 */
.need-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.need-item {
  background-color: #f0f5ff;
  color: #007aff;
  font-size: 28rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
}
.need-empty {
  background-color: #f6ffed;
  color: #52c41a;
  font-size: 28rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #b7eb8f;
}

/* 成员区域 */
.member-wrap {
  margin-top: 12rpx;
  padding-top: 28rpx;            /* 【优化】与基础信息区分 */
  border-top: 2rpx solid #f0f2f5;  /* 【优化】明显的分隔 */
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #222;
  padding-left: 18rpx;
  border-left: 8rpx solid #007aff;  /* 【优化】左边色条 */
  line-height: 1.2;
}
/* 【新增】标题行（左侧标题 + 右侧添加指导老师按钮） */
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.section-title-row .section-title {
  margin-bottom: 0;
}
.add-teacher-btn {
  font-size: 26rpx;
  color: #ff8c00;
  background: #fff7e8;
  border: 1rpx solid #ffd591;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  flex-shrink: 0;
}
.add-teacher-btn:active { opacity: 0.75; }
.member-list {

}
.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  background-color: #f8f9fb;
}
.captain-bg {
  background-color: #e8f2ff;
}
.avatar-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #d8dde6;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.member-main {
  flex: 1;
}
.name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.cap-tag {
  background-color: #007aff;
  color: #fff;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.username {
  font-size: 30rpx;
  color: #222;
}
.skill-desc {
  display: inline-block;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  margin-top: 10rpx;
  background: #F2F4F7;
  color: #777;
}
/* 按技能 AI 评级等级染色（与个人页 skill-tag 同色系） */
.skill-desc.lv0 { background: #F2F4F7; color: #9CA3AF; }
.skill-desc.lv1 { background: #F3F4F6; color: #6B7280; }
.skill-desc.lv2 { background: #E8F1FF; color: #4F8CFF; }
.skill-desc.lv3 { background: #F3EEFF; color: #8B5CF6; }
.skill-desc.lv4 { background: #FFF6E6; color: #D97706; }
.skill-desc.lv5 { background: #FDECEC; color: #EF4444; box-shadow: 0 0 10rpx rgba(239, 68, 68, 0.35); }

/* ==================== 成员操作浮层（action sheet） ==================== */
.action-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 998;
}
.action-sheet {
  position: absolute; /* 相对 mask 定位，left/top 由 JS 锚定到点击图标旁边 */
  background: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  min-width: 260rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.12);
}
.action-item {
  padding: 24rpx 40rpx;
  font-size: 30rpx;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
  text-align: center;
}
.action-item:last-child { border-bottom: none; }
.action-item:active { background: #f5f7fa; }
.action-danger { color: #EF4444; }

/* ==================== 成员主页卡片 ==================== */
.user-home-card {
  background: #fff;
  border-radius: 16rpx;
  width: 600rpx;
  padding: 50rpx 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.home-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-top: -90rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}
.home-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-top: 16rpx;
}
.home-intro {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-top: 12rpx;
  width: 100%;
  text-align: center;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}
.home-intro--empty { color: #bbb; }
.home-skill-wrap {
  width: 100%;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}
.home-skill-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 14rpx;
}
.home-skill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.home-skill-tag {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  background: #F2F4F7;
  color: #9CA3AF;
}
.home-skill-tag.lv0 { background: #F2F4F7; color: #9CA3AF; }
.home-skill-tag.lv1 { background: #F3F4F6; color: #6B7280; }
.home-skill-tag.lv2 { background: #E8F1FF; color: #4F8CFF; }
.home-skill-tag.lv3 { background: #F3EEFF; color: #8B5CF6; }
.home-skill-tag.lv4 { background: #FFF6E6; color: #D97706; }
.home-skill-tag.lv5 { background: #FDECEC; color: #EF4444; }
.home-skill-empty {
  font-size: 24rpx;
  color: #bbb;
}
/* 邮箱区块（隐私：自己直接显示；队友点"获取邮箱"才拉取） */
.home-email-wrap {
  width: 100%;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}
.home-email-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 14rpx;
}
.home-email-body {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}
.home-email-val {
  font-size: 26rpx;
  color: #333;
  word-break: break-all;
  min-width: 0;
  flex: 1;
}
.home-email-copy {
  font-size: 24rpx;
  color: #007aff;
  flex-shrink: 0;
}
.home-email-empty {
  font-size: 24rpx;
  color: #bbb;
}
.home-email-btn {
  width: 200rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: #fff;
  background: #007aff;
  border: none;
  border-radius: 32rpx;
  padding: 0;
  text-align: center;
}
.home-email-btn::after { border: none; }
.home-email-btn:active { opacity: 0.85; }
.home-close-btn {
  margin-top: 30rpx;
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
.home-close-btn::after { border: none; }
/* 成员操作图标（替代原"箭头 >"位置；只点图标才触发操作） */
.member-action-icon {
  width: 36rpx;
  height: 36rpx;
  margin-left: auto;
  margin-right: 6rpx;
  padding: 14rpx;
  box-sizing: content-box;
  flex-shrink: 0;
  opacity: 0.55;
}
.member-action-icon:active { opacity: 1; }

/* ===== 底部固定按钮区域（优化布局） ===== */
.fixed-btn-box {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;                /* 【修改】flex水平排列 */
  gap: 20rpx;                  /* 按钮间距 */
  padding: 24rpx 32rpx;
  background-color: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05);
}

/* 所有底部按钮统一样式 */
.fixed-btn-box button {
  flex: 1;                    /* 均分宽度 */
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border: none;
  border-radius: 14rpx;
  padding: 0;
  text-align: center;
  box-sizing: border-box;
}

/* 各个按钮颜色 */
.btn-edit {
  background-color: #4caf50;
  color: #ffffff;
}
.btn-primary {
  background-color: #007aff;
  color: #ffffff;
}
.btn-gray {
  background-color: #cccccc;
  color: #666666;
}
.btn-more {
  background-color: #FF9500;
  color: #ffffff;
}

/* 弹窗遮罩 */
.mask-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;            /* 【修复】提到最高层，避免被 .fixed-btn-box 等覆盖 */
}
.popup-box {
  width: 640rpx;           /* 【修复】560→640，更舒展 */
  max-width: 92vw;         /* 【修复】小屏自适应 */
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.15);
}
.popup-text {
  padding: 48rpx 32rpx;
  text-align: center;
  font-size: 30rpx;
}
.popup-btns {
  display: flex;
  border-top: 1rpx solid #eee;
}
.popup-btns button {
  flex: 1;
  border-radius: 0;
  margin: 0;
}
.btn-cancel {
  background-color: #ffffff;
  color: #666;
  border-right:1rpx solid #eee;
}
.btn-danger {
  background-color: #ff4d4f;
  color: #fff;
}

/* ===== 入队申请 ===== */
.btn-apply {
  position: relative;
  background-color: #286ebe83;
  color: #ffffffff;
  border: 2rpx solid #ffffffff;
  font-weight: 500;
}
.apply-entry-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: #E85C5C;
  color: #fff;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
  z-index: 1;
}
.apply-popup {
  display: flex;
  flex-direction: column;
  width: 100%;             /* 【修复】撑满 .popup-box */
}
/* 【改版】标题栏：标题居中，右上角浮一个 X 关闭 */
.popup-title-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #f0f0f0;
}
.popup-title {
  padding: 28rpx 32rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}
.popup-close {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 44rpx;
  color: #999;
  font-weight: 300;
  z-index: 2;
}
.popup-close:active {
  opacity: 0.5;
}
.apply-scroll {
  width: 100%;             /* 【修复】flex column 容器中撑满宽度，否则子项会被压缩到 0 宽 */
  max-height: 60vh;
  padding: 0 32rpx;
  box-sizing: border-box;
}
/* 【改版】上下布局：申请信息 → 按钮 */
.apply-item {
  display: flex;
  flex-direction: column;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
}
.apply-info {
  margin-bottom: 20rpx;    /* 【改版】上下布局，与按钮拉开距离 */
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.apply-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.apply-skill {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.apply-actions {
  display: flex;
  gap: 20rpx;
  justify-content: space-between;
}
.apply-btn {
  flex: 1;                /* 【改版】上下布局后，按钮均分宽度 */
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  border-radius: 32rpx;
  padding: 0;
  margin: 0;
}
.apply-btn::after { border: none; }
.apply-btn.reject {
  background: #f3f4f6;
  color: #666;
}
.apply-btn.agree {
  background: #409EFF;
  color: #fff;
}
.apply-empty {
  font-size: 26rpx;
  color: #999;
  padding: 40rpx 0;
  text-align: center;
}

/* ===== 【新增】添加指导老师弹窗 ===== */
.teacher-picker {
  display: flex;
  flex-direction: column;
  width: 100%;
}
.teacher-scroll {
  width: 100%;
  max-height: 60vh;
  padding: 0 32rpx;
  box-sizing: border-box;
}
.teacher-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.teacher-item:last-child { border-bottom: none; }
.teacher-item:active { opacity: 0.7; }
.teacher-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #eef1f5;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.teacher-main {
  flex: 1;
  min-width: 0;
}
.teacher-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.teacher-institute {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.teacher-invite-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #fff;
  background: #ff8c00;
  border-radius: 999rpx;
  padding: 10rpx 30rpx;
  margin-left: 16rpx;
}
/* ===== 【改造】添加指导老师：uid 搜索 ===== */
.advisor-search-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
}
.advisor-search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  font-size: 28rpx;
  box-sizing: border-box;
}
.advisor-search-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  height: 72rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #ff8c00;
  color: #fff;
  font-size: 28rpx;
}
.advisor-search-btn:active { opacity: 0.8; }
.advisor-result {
  display: flex;
  align-items: center;
  padding: 8rpx 32rpx 28rpx;
}
.advisor-tip {
  padding: 8rpx 32rpx 32rpx;
  font-size: 26rpx;
  color: #999;
}

.empty-load {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
  color: #999;
  font-size: 28rpx;
}

.teacher-tag {
  background-color: #ff8c00;
  color: #ffffff;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

/* ===== 非队员：队长主页入口 ===== */
.leader-home-wrap {
  margin-top: 12rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid #f0f2f5;
}
.leader-card {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  background: #e8f2ff;
}
.leader-card:active { opacity: 0.85; }
.leader-arrow {
  font-size: 44rpx;
  color: #007aff;
  margin-left: 12rpx;
  flex-shrink: 0;
  line-height: 1;
}