.team-push-container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}
.form-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin: 30rpx 0;
}
.form-item {
  background: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
}
.form-label {
  display: block; /* 确保label块级显示 */
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.required {
  color: #ff4d4f;
  margin-left: 4rpx;
}
input, textarea {
  width: 100%;
  padding: 15rpx;
  border: 1px solid #eee;
  border-radius: 5rpx;
  font-size: 26rpx;
}
/* 赛事搜索输入框 */
.comp-search-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.selected-comp-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.comp-tag {
  padding: 12rpx 24rpx;
  background: #e8f3ff;
  color: #1677ff;
  border-radius: 8rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tag-hover {
  opacity: 0.7;
}

