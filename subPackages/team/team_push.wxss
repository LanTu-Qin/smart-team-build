/* 搜索结果列表 */
.comp-search-result {
  max-height: 400rpx;
  overflow-y: auto;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
}

/* 搜索结果项 */
.result-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.result-item:last-child {
  border-bottom: none;
}

.result-item:active {
  background: #f5f5f5;
}

/* 空结果提示 */
.comp-search-empty {
  padding: 20rpx;
  text-align: center;
  color: #999;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
}
.picker-display {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 16rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #fff;
}
.needs-tips {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 15rpx;
}
.needs-list {
  margin-top: 10rpx;
}
.need-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1px solid #eee;
}
/* 【新增】技能名行，给"队长"标签留空间 */
.skill-name {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
/* 【新增】队长标签：蓝底小徽标 */
.leader-tag {
  font-size: 18rpx;
  color: #1989fa;
  background: rgba(25, 137, 250, 0.1);
  border: 1rpx solid rgba(25, 137, 250, 0.3);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  line-height: 1.4;
}
/* 【新增】队长技能说明文字（替代删除按钮的位置） */
.leader-lock {
  font-size: 22rpx;
  color: #bbb;
}
.num-adjust {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
/* 【新增】加减号按钮统一高度，禁用时灰显 */
.num-btn {
  min-width: 52rpx;
  padding: 0 8rpx;
  line-height: 1.6;
}
.num-btn[disabled] {
  color: #ccc !important;
  background: #f5f5f5 !important;
}
.add-need-btn {
  margin-top: 10rpx;
  background: #e8f4f8;
  color: #1989fa;
}
.submit-btn {
  background: #1989fa;
  color: #fff;
  padding: 20rpx;
  font-size: 28rpx;
  border-radius: 10rpx;
  margin-top: 30rpx;
}
.submit-btn[disabled] {
  background: #ccc;
}