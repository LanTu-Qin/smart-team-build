page {
  background: #f7f8fa;
  padding-bottom: 120rpx;
}

/* 管理员 AI 生成详情 */
.ai-gen-wrap {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
}
.ai-gen-btn {
  background: #4f7cff;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0 40rpx;
}
.ai-gen-btn[disabled] {
  opacity: 0.7;
  color: #fff;
  background: #4f7cff;
}
.ai-gen-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9aa0ad;
}
.page-wrap { padding: 24rpx; }
.loading-wrap, .empty-tip {
  padding: 120rpx 0; text-align: center; color: #999; font-size: 28rpx;
}

/* 信息卡片重构 */
.info-card {
  background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx;
}
.title-wrap {
  display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20rpx;
}
.title { font-size: 36rpx; font-weight: bold; flex: 1; line-height: 1.; }
.status-badge {
  font-size: 24rpx; padding: 4rpx 14rpx; border-radius: 30rpx; white-space: nowrap;
  margin-left: 12rpx; margin-top: 6rpx;
}
.badge-ing { background: #e8f8ee; color: #07c160; }
.badge-end { background: #ffebeb; color: #e64340; }

/* 时间与元数据 */
/* 布局基础，统一左侧宽150rpx，保障文字完全对齐 */
.info-row {
  display: flex;
  align-items: center; /* 保证左侧文字和右侧内容垂直居中 */
}

.label {
  color: #888;
  font-size: 26rpx;
  width: 150rpx; /* 固定宽度，强制所有行左侧对齐 */
  flex-shrink: 0; /* 防止宽度被压缩 */
}
.value {
  color: #333;
  font-size: 28rpx;
  flex: 1; /* 占满剩余空间 */
}

/* 分割线微调间距 */
.divider {
  height: 1rpx;
  background: #eee;
  margin: 24rpx 0;
}

/* 时间区块 - 去掉 flex 并排，改为普通块级上下排列 */
.time-row-block {
  display: block;
}
.time-row-block .info-row {
  margin-top: 16rpx;
}
.time-row-block .info-row:first-child {
  margin-top: 0;
}

/* 参赛方式标签 - 强化垂直居中 */
.type-tag {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  display: flex; /* 改成 inline-flex 解决偏上偏下问题 */
  align-items: center;
  justify-content: center;
  /* 避免标签文字撑高行距 */
  line-height: 1.4; 
}
.tag-individual { background: #e6f7ff; color: #1890ff; }
.tag-team { background: #f9f0ff; color: #722ed1; }
.tag-mixed { background: #fff7e6; color: #fa8c16; }
.label {
  color: #888;
  font-size: 26rpx;
  width: 150rpx;
  flex-shrink: 0;
  line-height: 1.4;       /* 加上这个，使左侧文字的行高与右侧标签接近 */
}
/* 官网链接 */
/* 覆盖原来 .url-row 和 .url-box */
.url-row {
  display: flex;
  align-items: center;      /* 绝对保证左侧标签和右侧框体在一条水平线上 */
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 4rpx 0;          /* 增加一些点击区域余量 */
}

.url-box {
  display: flex;
  align-items: center;
  flex: 1;                  /* 占据右侧剩余全部宽度 */
  background: #f5f7fa;      /* 比之前稍微清淡一点的灰色 */
  padding: 12rpx 20rpx;     /* 增加内边距，更透气 */
  border-radius: 12rpx;
  min-width: 0;             /* 核心：解决 flex 布局中文本无法截断的问题 */
}

.url-text {
  font-size: 26rpx;
  color: #007aff;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;  /* 超长自动变省略号 */
  line-height: 1.4;         /* 略微增加行高，居中更自然 */
}

.arrow {
  color: #c0c4cc;           /* 使用浅灰色，让用户更关注蓝色链接 */
  margin-left: 8rpx;
  font-size: 28rpx;
  line-height: 1;
}


/* 海报卡片 */
.poster-card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; }
.card-title { font-size: 32rpx; margin-bottom: 20rpx; font-weight: 500; }
.poster-img { width: 100%; height: 380rpx; border-radius: 12rpx; }
.empty-poster { width: 100%; height: 380rpx; background: #eee; display: flex; align-items: center; justify-content: center; color: #999; border-radius: 12rpx; }

/* 详情卡片 */
/* competition_info.wxss */

/* 卡片内通用行容器 */
.line-item {
  margin-bottom: 6rpx;
}

/* 标题样式：加粗 + 左侧蓝色竖条 */
.line-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding: 12rpx 0 8rpx 18rpx;
  border-left: 6rpx solid #007aff;
  background: #f8faff;
  border-radius: 0 8rpx 8rpx 0;
  margin: 16rpx 0 10rpx 0;
  line-height: 1.5;
}

/* 列表项：增加缩进和圆点（上面已用 •，这里控制缩进） */
.line-list {
  display: block;
  font-size: 28rpx;
  color: #333;
  padding: 6rpx 0 6rpx 40rpx;
  line-height: 1.8;
  position: relative;
}

/* 为了更美观，可以用伪元素替代硬编码的 •，但为了兼容性保留 text 即可 */

/* 正文段落 */
.line-text {
  display: block;
  font-size: 28rpx;
  color: #444;
  line-height: 1.9;
  padding: 4rpx 0;
  text-align: justify;
}

/* 标签行：如 "主办/承办单位：xxx"、"赛事定位：xxx"，标签加粗区分 */
.line-label {
  display: block;
  font-size: 28rpx;
  color: #444;
  line-height: 1.9;
  padding: 4rpx 0;
  text-align: justify;
}
.label-name {
  font-weight: 600;
  color: #1f2d3d;
  margin-right: 4rpx;
}
.label-text {
  color: #444;
}

/* 空状态小字 */
.empty-tip-small {
  color: #bbb;
  font-size: 26rpx;
  padding: 20rpx 0;
  text-align: center;
}

/* 底部操作按钮：发布队伍 + 匹配 */
.submit-btn-wrap {
  position: fixed; left: 0; bottom: 0; width: 100%; height: 96rpx;
  display: flex; align-items: center;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.btn-item {
  flex: 1;
  height: 100%;
  display: flex; align-items: center; justify-content: center;
  line-height: 1;   /* 消除 view 默认行高对 flex 居中的干扰 */
}
.btn-team { background: #007aff; }
.btn-match { background: #FF9500; }
.btn-item:active { opacity: 0.85; }
/* 已结束赛事：按钮置灰，禁止发布队伍/匹配 */
.btn-item.btn-disabled {
  background: #c0c4cc;
  opacity: 0.6;
}
.btn-item.btn-disabled:active { opacity: 0.6; }
.sign-text {
  color: #fff; font-size: 34rpx; font-weight: 500;
  line-height: 1.4;   /* 显式控制文字行高，避免偏上 */
}
/* 【新增】个人参赛按钮（个人赛 / 混合赛主入口） */
.btn-personal { background: #34c759; }
.btn-item.btn-disabled.btn-personal { background: #c0c4cc; }

/* ===== 【新增】参赛模式选择弹窗 ===== */
.mask-layer {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.popup-box {
  width: 640rpx;
  max-width: 92vw;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
}
.popup-title-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #f0f0f0;
}
.popup-title {
  padding: 28rpx 32rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}
.popup-close {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 12rpx 20rpx;
  font-size: 40rpx;
  color: #999;
  font-weight: 300;
  z-index: 2;
}
.popup-close:active { opacity: 0.5; }
.sign-mode-option {
  display: flex;
  flex-direction: column;
  padding: 28rpx 40rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.sign-mode-option:last-child { border-bottom: none; }
.sign-mode-option:active { background: #f7f8fa; }
.mode-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.mode-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

/* ===== 【新增】个人参赛技能选择弹窗 ===== */
.personal-sign-tip {
  padding: 24rpx 40rpx 8rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}
.personal-skill-picker {
  margin: 24rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fafbfc;
}
.personal-skill-name {
  font-size: 30rpx;
  color: #333;
}
.personal-skill-arrow {
  font-size: 40rpx;
  color: #bbb;
}
.personal-sign-btn {
  margin: 8rpx 40rpx 40rpx;
  background: #34c759;
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
}
.personal-sign-btn:active { opacity: 0.85; }
.personal-sign-btn[disabled] { background: #c0c4cc; }