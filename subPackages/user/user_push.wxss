.page-wrap {
  min-height: 100vh;
  background: #F5F6F8;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 赛事只读 */
.comp-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.comp-name {
  font-size: 32rpx;
  color: #111;
  font-weight: 600;
  flex: 1;
  margin-right: 20rpx;
}
.comp-status {
  font-size: 22rpx;
  color: #fff;
  background: #FF9500;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.comp-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #bbb;
}

/* 技能选择（横排紧凑布局） */
.skill-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}
.skill-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.skill-item {
  /* 2 列：(750 - 48padding - 16gap) / 2 = 343rpx */
  width: 343rpx;
  height: 96rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  background: #FAFAFB;
  transition: all 0.15s;
}
.skill-item.skill-checked {
  border-color: #007aff;
  background: #F0F7FF;
}
.skill-name {
  flex: 1;
  min-width: 0; /* 关键：让 ellipsis 在 flex 子项中生效 */
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.skill-level {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
/* 技能等级染色（与全站同色系） */
.skill-level.lv0 { background: #F2F4F7; color: #9CA3AF; }
.skill-level.lv1 { background: #F3F4F6; color: #6B7280; }
.skill-level.lv2 { background: #E8F1FF; color: #4F8CFF; }
.skill-level.lv3 { background: #F3EEFF; color: #8B5CF6; }
.skill-level.lv4 { background: #FFF6E6; color: #D97706; }
.skill-level.lv5 { background: #FDECEC; color: #EF4444; }
.empty-tip {
  font-size: 24rpx;
  color: #bbb;
  text-align: center;
  padding: 30rpx 0;
}

/* 底部完成按钮 */
.submit-bar {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}
.submit-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background: #007aff;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
}
.submit-btn::after { border: none; }
