.page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 身份切换器 */
.role-switcher {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
  padding: 0 20rpx;
}

.role-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #606266;
  background-color: #fff;
  border: 2rpx solid #dcdfe6;
  border-radius: 40rpx;
  transition: all 0.2s;
}

.role-btn.active {
  background-color: #409EFF;
  color: #fff;
  border-color: #409EFF;
  font-weight: 500;
}

/* 表单卡片 */
.form-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 40rpx;
}

/* 底部按钮 */
.btn-area {
  padding: 0 20rpx;
}

.submit-btn {
  border-radius: 44rpx !important;
  height: 88rpx !important;
  font-size: 32rpx !important;
}