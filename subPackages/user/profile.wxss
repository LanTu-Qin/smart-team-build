page {
	--primary: #4F8CFF;
	--primary-2: #6E5BEF;
	--primary-light: #EBF2FF;
	--text-1: #1F2937;
	--text-2: #6B7280;
	--text-3: #9CA3AF;
	--border: #F0F2F5;
	--card: #FFFFFF;
	background: #F5F7FA;
}

.page {
	padding-bottom: 220rpx;
}

/* ========== 顶部渐变头部 ========== */
.header {
	position: relative;
	z-index: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 60rpx 30rpx 56rpx;
	background: linear-gradient(135deg, #4F8CFF 0%, #6E5BEF 100%);
	border-radius: 0 0 48rpx 48rpx;
	box-shadow: 0 12rpx 32rpx rgba(79, 140, 255, 0.25);
}
.avatar-wrapper {
	margin-top: 10rpx;
	padding: 6rpx;
	background: #fff;
	border-radius: 50%;
	box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}
.avatar {
	width: 176rpx;
	height: 176rpx;
	border-radius: 50%;
	display: block;
	background: #EEF1F6;
}
.avatar-badge {
	position: absolute;
	right: 0;
	bottom: 0;
	width: 52rpx;
	height: 52rpx;
	background: linear-gradient(135deg, #4F8CFF 0%, #6E5BEF 100%);
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	border: 4rpx solid #fff;
	box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
}
.header-name {
	margin-top: 24rpx;
	font-size: 36rpx;
	font-weight: 600;
	color: #fff;
	letter-spacing: 1rpx;
}
.header-name--placeholder {
	opacity: 0.7;
	font-weight: 400;
}
.header-action {
	margin-top: 20rpx;
	display: flex;
	align-items: center;
	gap: 8rpx;
	padding: 8rpx 24rpx;
	background: rgba(255, 255, 255, 0.22);
	border-radius: 30rpx;
	font-size: 24rpx;
	color: #fff;
	border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* ========== 通用卡片 ========== */
.card {
	position: relative;
	z-index: 2;
	margin: 24rpx 30rpx 0;
	background: var(--card);
	border-radius: 24rpx;
	padding: 32rpx 30rpx;
	box-shadow: 0 6rpx 20rpx rgba(31, 41, 55, 0.05);
}
.card-title {
	display: flex;
	align-items: center;
	margin-bottom: 8rpx;
}
.title-bar {
	width: 6rpx;
	height: 28rpx;
	background: linear-gradient(180deg, #4F8CFF 0%, #6E5BEF 100%);
	border-radius: 4rpx;
	margin-right: 14rpx;
}
.card-title > text {
	font-size: 30rpx;
	font-weight: 600;
	color: var(--text-1);
	flex: 1;
}
.counter {
	font-size: 24rpx;
	font-weight: 400;
	color: var(--text-3);
}
.ph {
	color: #C0C4CC;
}

/* ========== 表单行（标签左、输入右） ========== */
.field-row {
	display: flex;
	align-items: center;
	padding: 26rpx 0;
}
.field-label {
	/* 不用固定宽度，让必填红 * 紧贴 label 文字 */
	font-size: 30rpx;
	color: var(--text-1);
	flex-shrink: 0;
}
.required {
	color: #FF4D4F;
	margin-right: 4rpx;
}
.field-input {
	flex: 1;
	font-size: 30rpx;
	color: var(--text-1);
	text-align: right;
}
.field-divider {
	height: 1rpx;
	background: var(--border);
}

/* ========== 个人简介 ========== */
.intro-textarea {
	width: 100%;
	min-height: 180rpx;
	font-size: 28rpx;
	line-height: 1.7;
	color: var(--text-1);
	padding: 20rpx 0 0;
	box-sizing: border-box;
}

/* ========== 技能选择 ========== */
.skill-tip {
	display: flex;
	align-items: center;
	gap: 10rpx;
	font-size: 24rpx;
	color: var(--text-2);
	margin: 16rpx 0 24rpx;
	padding: 14rpx 20rpx;
	background: #F4F8FF;
	border-radius: 12rpx;
}
.skill-tip-dot {
	width: 10rpx;
	height: 10rpx;
	border-radius: 50%;
	background: linear-gradient(135deg, #4F8CFF 0%, #6E5BEF 100%);
	flex-shrink: 0;
}
.skill-grid {
	display: flex;
	flex-wrap: wrap;
	gap: 16rpx;
	padding-top: 4rpx;
}
.skill-chip {
	padding: 12rpx 26rpx;
	font-size: 26rpx;
	color: var(--text-2);
	background: #F5F7FA;
	border-radius: 32rpx;
	border: 2rpx solid transparent;
	transition: all 0.15s ease;
}
.skill-chip--active {
	background: linear-gradient(135deg, #4F8CFF 0%, #6E5BEF 100%) !important;
	color: #fff !important;
	font-weight: 500;
	border-color: transparent;
	box-shadow: 0 6rpx 16rpx rgba(79, 140, 255, 0.32);
	transform: scale(1.02);
}

/* ========== 已选技能列表 ========== */
.selected-list {
	display: flex;
	flex-direction: column;
	gap: 16rpx;
	padding-top: 8rpx;
}
.selected-item {
	display: flex;
	align-items: center;
	gap: 20rpx;
	padding: 20rpx 24rpx;
	background: #F8FAFF;
	border-radius: 16rpx;
	border: 1rpx solid #EEF2F8;
}
.selected-item:active {
	background: #EEF4FF;
}
.selected-icon {
	width: 60rpx;
	height: 60rpx;
	border-radius: 50%;
	background: #fff;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
	box-shadow: 0 2rpx 8rpx rgba(79, 140, 255, 0.1);
}
/* 5星：红色光晕，突出"专家级" */
.selected-icon--glow {
	box-shadow: 0 0 16rpx rgba(239, 68, 68, 0.45), 0 2rpx 8rpx rgba(79, 140, 255, 0.1);
}
.selected-info {
	flex: 1;
	min-width: 0;
}
.selected-name {
	font-size: 28rpx;
	font-weight: 500;
	color: var(--text-1);
	margin-bottom: 6rpx;
}
.selected-desc {
	font-size: 24rpx;
	color: var(--text-3);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}
.selected-arrow {
	flex-shrink: 0;
}

/* ========== 底部 ========== */
.page-bottom {
	height: 40rpx;
}
.footer {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
	background: rgba(255, 255, 255, 0.96);
	backdrop-filter: blur(20rpx);
	z-index: 10;
	box-shadow: 0 -6rpx 24rpx rgba(31, 41, 55, 0.06);
}
.save-btn {
	width: 100%;
	height: 96rpx;
	background: linear-gradient(135deg, #4F8CFF 0%, #6E5BEF 100%);
	color: #fff;
	border-radius: 48rpx;
	font-size: 32rpx;
	font-weight: 500;
	border: none;
	box-shadow: 0 10rpx 24rpx rgba(79, 140, 255, 0.35);
	letter-spacing: 4rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 0;
	box-sizing: border-box;
}
.save-btn::after {
	border: none;
}
.save-btn[disabled] {
	background: #B8C8E0;
	color: #fff;
	box-shadow: none;
}

/* ========== 弹窗 ========== */
.popup-content {
	padding: 16rpx 50rpx 60rpx;
	text-align: center;
}
.popup-handle {
	width: 60rpx;
	height: 8rpx;
	background: #E5E7EB;
	border-radius: 4rpx;
	margin: 0 auto 30rpx;
}
.popup-icon {
	width: 120rpx;
	height: 120rpx;
	margin: 0 auto 24rpx;
	border-radius: 50%;
	background: linear-gradient(135deg, #EBF2FF 0%, #F0EBFF 100%);
	display: flex;
	align-items: center;
	justify-content: center;
}
.popup-title {
	font-size: 36rpx;
	font-weight: 600;
	color: var(--text-1);
	margin-bottom: 24rpx;
}
.popup-desc {
	font-size: 28rpx;
	line-height: 1.8;
	color: var(--text-2);
	text-align: left;
	padding: 28rpx 28rpx;
	background: #F8FAFF;
	border-radius: 16rpx;
	margin-bottom: 40rpx;
	min-height: 80rpx;
}
.popup-btn {
	display: inline-block;
	padding: 20rpx 80rpx;
	font-size: 30rpx;
	color: #fff;
	background: linear-gradient(135deg, #4F8CFF 0%, #6E5BEF 100%);
	border-radius: 40rpx;
	font-weight: 500;
	box-shadow: 0 8rpx 20rpx rgba(79, 140, 255, 0.35);
	letter-spacing: 2rpx;
}
